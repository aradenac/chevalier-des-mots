{
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:report": "mkdir -p build/test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=build/test-results/vitest-junit.xml",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build",
    "trace": "bash tools/trace.sh",
    "verify": "npm run test:report && npm run build && npm run trace && npm run docs:build"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
